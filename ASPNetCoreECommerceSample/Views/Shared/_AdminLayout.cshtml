    <script>
        $(document).ready(function () {
            // Function to update the cart count
            initializeCount();


            updateCartSummary();

            // Initial load
            updateCartCount();

            // Polling interval for real-time updates (e.g., every 5 seconds)
            setInterval(updateCartCount, 5000);

            // Optional: update immediately when an item is added to the cart
            $(document).on('click', '.add-to-cart-button', function () {
                updateCartCount();
            });


            $(".addToCart").click(function (e) {
                var id = this.id;

                $.ajax({
                    type: 'POST',
                    url: '/ShoppingCart/AddToCart',
                    data: {
                        returnUrl: $('#returnUrl').val(),
                        productId: id
                    },
                    success: function (data) {

                        // $('#summary_view').html(data);
                        updateCartSummary();
                    }
                });
            });

            function updateCartSummary() {
                $.ajax({
                    type: 'GET',
                    url: '/ShoppingCart/CartSummary',
                    success: function (data) {
                        $('#summary_view').html(data);
                    }
                });
            }

            function updateCartCount() {
                $.ajax({
                    url: '@Url.Action("GetCartItemCount", "ShoppingCart")',
                    type: 'GET',
                    success: function (data) {
                        // Update the span with the new count
                        $('.count-style').text(data);
                        initializeCount();
                    },
                    error: function () {
                        console.error('Failed to update cart count');
                    }
                });
            }


            $(".wishlistCart").click(function (e) {
                var id = this.id;

                $.ajax({
                    type: 'POST',
                    url: '/Wishlist/AddToWishlist',
                    data: {
                        returnUrl: $('#returnUrl').val(),
                        productId: id
                    },
                    success: function (data) {

                        // $('#summary_view').html(data);
                        //updateCartSummary();
                        // handle success response
                        window.location.href = data;
                    },
                    error: function (xhr, status, error) {
                        if (xhr.status === 401) {
                            // User is not authenticated, redirect to login page
                            window.location.href = '@Url.Action("Login", "Account")?returnUrl=' + encodeURIComponent(window.location.href);
                        } else {
                            // handle other errors
                        }
                    }
                });
            });

            function initializeCount() {
                if ($('.count-style').text() == '' || $('.count-style').text() == '0') {
                    $('.count-style').hide();
                }
                else {
                    $('.count-style').show();
                }
            }


        });//end of parent function


    </script>
