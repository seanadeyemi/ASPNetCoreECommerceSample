@model ASPNetCoreECommerceSample.Models.ProductModel

@{
	ViewBag.Title = "Product Detail";
}

<style>
    /* Main carousel styling */
    #main-carousel {
        margin-bottom: 1rem;
    }

    #main-carousel .splide__track {
        background: #f8f8f8;
        border-radius: 4px;
    }

    #main-carousel .splide__slide {
        display: flex;
        align-items: center;
        justify-content: center;
        aspect-ratio: 1;
        max-width: 100%;
        padding: 1rem;
    }

    #main-carousel .splide__slide img {
        max-width: 100%;
        max-height: 100%;
        width: auto;
        height: auto;
        object-fit: contain;
    }

    /* Thumbnail carousel styling */
    #thumbnail-carousel .splide__track {
        padding: 0.5rem 0;
    }

    #thumbnail-carousel .splide__slide {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 80px !important;
        height: 80px !important;
        margin-right: 0.5rem;
        border: 1px solid #ddd;
        border-radius: 4px;
        cursor: pointer;
        opacity: 0.6;
        transition: opacity 0.3s ease;
    }

    #thumbnail-carousel .splide__slide.is-active {
        border-color: #0066cc;
        opacity: 1;
    }

    #thumbnail-carousel .splide__slide img {
        max-width: 90%;
        max-height: 90%;
        width: auto;
        height: auto;
        object-fit: contain;
    }

    /* Form styling */
    .form-group {
        margin-bottom: 1rem;
    }

    .control-label {
        margin-bottom: 0.5rem;
    }

    /* Tags input styling */
    .tagsinput {
        border: 1px solid #ddd;
        padding: 0.5rem;
        border-radius: 4px;
        min-height: 44px;
    }

    .tag {
        display: inline-flex;
        align-items: center;
        background: #e9ecef;
        padding: 0.25rem 0.5rem;
        margin: 0.25rem;
        border-radius: 3px;
        font-size: 0.875rem;
    }

    .tag-text {
        margin-right: 0.25rem;
    }

    .tag-remove {
        border: none;
        background: none;
        color: #666;
        cursor: pointer;
        padding: 0 0.25rem;
        font-size: 1rem;
        line-height: 1;
    }

        .tag-remove:hover {
            color: #dc3545;
        }

    .tag-input {
        border: none;
        padding: 0.25rem;
        margin: 0.25rem;
        outline: none;
        min-width: 100px;
    }

        .tag-input:focus {
            outline: none;
        }

    @@media (max-width: 768px) {
        #main-carousel .splide__slide {
            aspect-ratio: 1;
        }

        #thumbnail-carousel .splide__slide {
            width: 60px !important;
            height: 60px !important;
        }
    }
</style>

<div class="container">
	<h2>@Model.Name</h2>

	<div class="row">
		<div class="col-lg-6 col-md-6">
			<section id="main-carousel" class="splide">
				<div class="splide__track">
					<ul class="splide__list">
						@{
							if (Model.ImagePaths != null)
							{
								for (var i = 0; i < Model.ImagePaths.Count; i++)
								{
									<li class="splide__slide">
										<img src="@Url.Content("~/")@Model.ImagePaths[i]" alt="">
									</li>
								}
							}
						}
					</ul>
				</div>
			</section>
			<section id="thumbnail-carousel"
					 class="splide"
					 aria-label="The carousel with thumbnails. Selecting a thumbnail will change the Beautiful Gallery carousel.">
				<div class="splide__track">
					<ul class="splide__list">
						@{
							if (Model.ImagePaths != null)
							{
								for (var i = 0; i < Model.ImagePaths.Count; i++)
								{

									<li class="splide__slide">
										<img src="@Url.Content("~/")@Model.ImagePaths[i]" alt="">
									</li>
								}
							}
						}
					</ul>
				</div>
			</section>

		</div>

		<div class="col-lg-6 col-md-6">
			<!-- Product details -->
			<h3>Details</h3>
			<p>@Model.Description</p>
			<p>AvailableColors: @Model.AvailableColors</p>
			<p>Quantity: @Model.Quantity</p>
			<p>Unit Price: @Model.NormalPrice</p>
			<p>Category: @Model.SelectedCategoryId</p>
		</div>
	</div>

	
</div>
<script>
	document.addEventListener('DOMContentLoaded', function () {
		var main = new Splide('#main-carousel', {
			type: 'fade',
			rewind: true,
			pagination: false,
			arrows: true,
		});


		var thumbnails = new Splide('#thumbnail-carousel', {
			fixedWidth: 100,
			fixedHeight: 60,
			gap: 10,
			rewind: true,
			pagination: false,
			isNavigation: true,
			breakpoints: {
				600: {
					fixedWidth: 60,
					fixedHeight: 44,
				},
			},
		});


		main.sync(thumbnails);
		main.mount();
		thumbnails.mount();
	});


</script>
 