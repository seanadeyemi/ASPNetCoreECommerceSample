@model List<ASPNetCoreECommerceSample.Models.BannerModel>
@{
	Layout = "~/Views/Shared/_AdminLayout.cshtml";
	ViewBag.Title = "Index";
	int index = 0;
}
<div class="container">

	<h2 class="pt-100 ">Banners</h2>
	<h4 class="pb-95">Manage all banners.</h4>

	<div class="d-flex justify-content-between align-items-center mb-3">
		<h4>Banner List</h4>
		@Html.ActionLink("Add Banner", "AddBanner", null, new { @class = "btn btn-primary btn-sm" })
	</div>


	<div class="row">

		<div class="col-lg-12 col-md-12 col-sm-12 col-12">
			<div>
				<table class="table table-bordered">
					<thead>
						<tr>
							<th>
								S/N
							</th>
							<th>
								Title
							</th>
							<th>
								Description 1
							</th>
							<th>
								Description 2
							</th>
						
							<th></th>
							<th></th>
						</tr>
					</thead>
					<tbody>
						@foreach (var banner in Model)
						{
							<tr>
								@{
									index++;
								}
								<td>
									@index
								</td>
								<td>
									<a href="/Banners/BannerDetails/@banner.Id">@banner.Title</a>
								</td>
								<td>
									@banner.Description1
								</td>
								<td>
									@banner.Description2
								</td>
								
								<td>
									<a href="/Banners/Edit/@banner.Id">Edit</a>
								</td>
								<td>
									@using (Html.BeginForm("Delete", "Banners", FormMethod.Post, new { id = "deleteForm" }))
									{
										@Html.AntiForgeryToken()
										@*@Html.HttpMethodOverride(HttpVerbs.Delete)*@
										@Html.Hidden("Id", banner.Id)

										<input type="submit" value="Delete" onclick="return confirmDelete();" class="btn btn-danger btn-xs" style="border-radius: 50px; padding: 7px 12px;" />
									}

									@*@Html.ActionLink("Delete","Delete", new {id = prod.Id}, new {onclick = "return confirm('Are you sure you really want to delete this product?');"})*@
								</td>
							</tr>
						}
					</tbody>

				</table>
			</div>
			

		</div>
	</div>
</div>



<script>
	function confirmDelete() {
		if (confirm('Are you sure you really want to delete this banner?')) {
			$.ajax({
				type: "POST",
				url: $("#deleteForm").attr("action"),
				data: $("#deleteForm").serialize(),
				success: function (response) {
					console.log("SUCCESS : ", data);
					window.location.href = data;
				},
				error: function (xhr, status, error) {

				}


			});

		}
		return false;
	}
</script>