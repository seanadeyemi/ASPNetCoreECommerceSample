@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery

@model ASPNetCoreECommerceSample.Models.CategoryModel

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2>Add Category</h2>

<form asp-action="AddCategory" asp-controller="Category" method="post" enctype="multipart/form-data">
    <div class="form-horizontal">
       
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="Id" />

        <div class="form-group">
            <label asp-for="Name" class="control-label col-md-2"></label>
            <div class="col-md-10">
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group">
            <label asp-for="ParentCategoryId" class="control-label col-md-2"></label>
            <div class="col-md-10">
                <select asp-for="ParentCategoryId" class="form-control" asp-items="ViewBag.ParentCategories">
                    <option value="">Select Parent Category</option>
                </select>
                <span asp-validation-for="ParentCategoryId" class="text-danger"></span>
            </div>
        </div>

    </div>
    <div class="form-group">
        <div class="col-md-offset-2 col-md-10">
            <button type="submit" class="btn btn-primary">Save</button>
        </div>
    </div>
</form>
